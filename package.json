{
  "name": "quiet-reader-desktop",
  "version": "1.0.3",
  "description": "A local EPUB reader with editing support.",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.cjs",
    "build:styles": "tailwindcss -c tailwind.config.cjs -i app/tailwind.input.css -o app/vendor/tailwind.css --minify",
    "prepare": "npm run prepare-assets && npm run build:styles",
    "start": "npm run prepare && electron .",
    "package:win": "npm run prepare && electron-builder --win --x64",
    "release:win": "npm run package:win"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.fritz.quietreader",
    "productName": "闈欒闃呰鍣?,
    "artifactName": "QuietReader-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "fritz1024",
        "repo": "quiet-reader-desktop"
      }
    ],
    "files": [
      "app/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "QuietReader-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "闈欒闃呰鍣?,
      "perMachine": false
    },
    "fileAssociations": [
      {
        "ext": "epub",
        "name": "QuietReader.epub",
        "description": "EPUB 鐢靛瓙涔?,
        "role": "Editor"
      }
    ]
  }
}
